# Copy to .env.local — never commit real secrets.

# OpenRouter API key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Public site URL (local or Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp in international format without + (optional override; default in code: 6288901178816)
NEXT_PUBLIC_WA_NUMBER=6288901178816

# Fase 2 — Supabase (required for /order and /lacak)
SUPABASE_URL=
# Prefer service_role; anon/publishable also works with RLS policies in fase-2-setup.md
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Fase 2 — admin panel (/admin/orders?secret=...)
ADMIN_SECRET=

# Fase 2 — email notify on new order (optional, Resend free)
ADMIN_EMAIL=
RESEND_API_KEY=
RESEND_FROM=designtuntas <onboarding@resend.dev>
